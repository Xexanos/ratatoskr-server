{
  "name": "@ratatoskr/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@ratatoskr/contract": "workspace:*",
    "@ratatoskr/position": "workspace:*",
    "@svrooij/sonos": "^2.5.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.5",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@fastify/response-validation": "^3.0.4",
    "@ratatoskr/fake-sonos": "workspace:*",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
